# ============ 构建产物 ============
target/
*.class
*.jar
*.war
*.nar
*.zip
*.tar.gz
*.rar
dependency-reduced-pom.xml
.flattened-pom.xml

# ============ 运行时数据（绝不入库）============
# data/ 全是本机运行态：H2 库、上传附件、Lucene 索引、书库内容、备份、PID。
# 首次启动由 LibrarySyncService 等自己建目录，无需预置。
data/

# 兜底：万一 data/ 之外出现这些文件
*.mv.db
*.trace.db
*.pid
*.h2.db

# ============ 日志 ============
*.log
logs/

# ============ Python / laya 侧车 ============
# 侧车源码（sidecar/laya/、laya_server.py、requirements.txt）必须入库，
# 但 venv（约 900 MB）与权重（data/laya/ 约 650 MB）绝不入库。
__pycache__/
*.py[cod]
.venv/
venv/
sidecar/.venv/

# ============ 编辑器 / IDE ============
.idea/
*.iml
.vscode/
.trae/
.workbuddy/

# ============ 系统 ============
.DS_Store
Thumbs.db
.netrwhist

# ============ JVM 崩溃日志 ============
# 见 http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
*.hprof
.mtj.tmp/
*.ctxt
