<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.miaocang</groupId>
    <artifactId>miaocang-service</artifactId>
    <version>1.0.0</version>
    <name>miaocang-service</name>
    <description>喵藏 - 内容引力波整理系统：将网页链接/Word/Excel 内容自动分层归类成拥有两级目录的书</description>

    <properties>
        <java.version>17</java.version>
        <poi.version>5.3.0</poi.version>
        <jsoup.version>1.18.3</jsoup.version>
        <lucene.version>9.12.1</lucene.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- H2 内嵌数据库，零配置启动；数据落盘 ./data/miaocang.mv.db -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 登录认证：仅取 BCrypt 密码散列（参照 citadel 的密码加密方案，不引入 Spring Security 全家桶） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- 全库全文检索（我的学习/全局搜索框）：Lucene + SmartChinese 中文分词 -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-core</artifactId>
            <version>${lucene.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-queryparser</artifactId>
            <version>${lucene.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-analysis-smartcn</artifactId>
            <version>${lucene.version}</version>
        </dependency>

        <!-- Word/Excel 解析 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- 网页抓取 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

        <!-- agentscope-harness：每只猫专属会话区 + 四层压缩记忆
             注意：不导入 agentscope-dependencies-bom（其 Spring Boot 4.0.4 与本项目 3.5.5 冲突）。
             直接添加三个 artifacts；Spring Boot 3.5.5 父 BOM 的 dependencyManagement 会覆盖
             jackson / reactor / slf4j / snakeyaml 等传递依赖版本。 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
            <version>2.0.0</version>
            <exclusions>
                <!-- MiaoCang 用 H2，不需要 sqlite-jdbc 共存（agentscope-harness 仅用于状态存储可选） -->
                <exclusion>
                    <groupId>org.xerial</groupId>
                    <artifactId>sqlite-jdbc</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 兼容最新 JDK 运行时（ByteBuddy 识别新版本号） -->
                    <jvmArguments>-Dnet.bytebuddy.experimental=true</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
